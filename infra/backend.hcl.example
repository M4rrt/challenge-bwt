# Copy to backend.hcl (gitignored) and pass to `terraform init -backend-config=backend.hcl`.
# Bucket/table names below match infra/bootstrap/'s default var.project/var.environment
# ("chat-app"/"local") — if you customized those when running the bootstrap, update the names
# here to match its outputs (`state_bucket`, `lock_table`).

bucket         = "chat-app-local-terraform-state"
key            = "chat-app/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "chat-app-local-terraform-lock"

# LocalStack overrides — omit these five plus `endpoints` when pointing at real AWS.
access_key                  = "test"
secret_key                  = "test"
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
skip_region_validation      = true
use_path_style              = true

endpoints = {
  s3       = "http://localhost:4566"
  dynamodb = "http://localhost:4566"
}
