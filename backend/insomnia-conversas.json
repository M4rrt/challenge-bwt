      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"beto@example.com\",\n  \"password\": \"senha-forte-123\"\n}"
      },
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "description": "Copy response `id` -> env `user_b_id`.",
      "metaSortKey": 1
    },
