    {
      "_id": "fld_auth",
      "_type": "request_group",
      "parentId": "wrk_chatapp",
      "name": "01 - Auth (register + login 4 users)",
      "description": "Run in order. After each register, copy the response `id` into the matching user_x_id env var. After each login, copy `access_token` into the matching token_x env var. User D never gets added to a conversation — it exists to prove isolation.",
      "metaSortKey": 0
    },
    {
