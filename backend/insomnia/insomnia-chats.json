    {
      "_id": "req_me",
      "_type": "request",
      "parentId": "fld_setup",
      "name": "Me (confere o token_a)",
      "method": "GET",
      "url": "{{ _.base_url }}/auth/me",
      "description": "Devolve o que o token afirma: id, company_id, user_kind, scopes, display_name. O serviço não tem tabela de usuário — isto é o token lido de volta, não um perfil consultado. 401 aqui significa token expirado ou JWT_SECRET_KEY diferente do que assinou.",
      "metaSortKey": 1,
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ _.token_a }}"
        }
      ]
