        "text": "{\"company_id\": \"11111111-1111-1111-1111-111111111111\", \"chat_id\": \"2811b4a5-60d9-4f81-b899-3e78012b29b9\", \"body\": \"Hello from Insomnia\", \"source_label\": \"Insomnia Test\"}"
      }
    },
