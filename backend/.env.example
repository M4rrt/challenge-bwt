DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5544/chat
REDIS_URL=redis://localhost:6380/0
JWT_SECRET_KEY=change-me
WEBHOOK_HMAC_SECRET=change-me
INTERNAL_SERVICE_TOKEN=change-me
FRONTEND_ORIGIN=http://localhost:5173
# Quanto vive um chat token, como o monólito o emite — o serviço não emite nada
# e não impõe isso. É o prazo de uma entrada de denylist que bloqueia uma PESSOA:
# ela tem que expirar junto com o último token dela que ainda poderia estar fora.
CHAT_TOKEN_TTL_SECONDS=900
