DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5544/chat
REDIS_URL=redis://localhost:6381/0
# A JWKS document (RFC 7517): the public key(s) the service trusts, keyed by
# `kid`. The monolith is the only signer; this is only ever a public key.
# Below is the test key pair tests/chat_tokens.py signs with — replace with
# the real key(s) the monolith publishes before pointing this at production.
CHAT_TOKEN_JWKS={"keys": [{"alg": "RS256", "kty": "RSA", "n": "065cm5vw-A5Qg8bvn1aJeb9jRP19OUDNtJP_-b3l3e2I36TMkCS6I8Xiv_SgkX2q4xcac_9--jy6ya3KjHHaaDXMuTCTcCpyRUa9j8UyrfuWlwYUIesqfD6L8yjY6oxSwZqtDgZ3R8wc35661UMXWGyNpA_SPi-V6JXOU_TnLoAJPxurnGKBCBG0SSNd_-u1Ofh-vvllIxvvlYRLk2zAzDAGZk2ziJ6o4EKgmriTEdjS2H1Y6qfmZgMs7u8A4J3omvMDQ7YbEjF0qLuDkHBMtrRdpVVtu-i7Qe2XXXyaVoVxqGA-JgjHbk3JrESw_p4O8RIlavGEc7CV8-CJPQnGQw", "e": "AQAB", "kid": "test-chat-key-1", "use": "sig"}]}
# Optional: consulted opportunistically for key rotation; unset is a valid,
# if unrotatable, configuration.
# CHAT_TOKEN_JWKS_URL=https://api.brwinetours.com/.well-known/chat-jwks.json
CHAT_TOKEN_AUDIENCE=bwt-chat
WEBHOOK_HMAC_SECRET=change-me
INTERNAL_SERVICE_TOKEN=change-me
FRONTEND_ORIGIN=http://localhost:5173
# Quanto vive um chat token, como o monólito o emite — o serviço não emite nada
# e não impõe isso. É o prazo de uma entrada de denylist que bloqueia uma PESSOA:
# ela tem que expirar junto com o último token dela que ainda poderia estar fora.
CHAT_TOKEN_TTL_SECONDS=900
